{
  "info": {
    "_postman_id": "2a4e2a73-3d16-4b47-9b53-0e4f4f8f3b75",
    "name": "ServeRest API - QA Portfolio",
    "description": "Colecao automatizada para validar fluxos de usuarios, autenticacao e produtos na API ServeRest.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "if (pm.request.body && pm.request.body.mode === 'raw') {",
          "  pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('tempo de resposta abaixo de 5000ms', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "pm.test('resposta JSON quando houver body', function () {",
          "  if (pm.response.text()) {",
          "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
          "  }",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://serverest.dev"
    }
  ],
  "item": [
    {
      "name": "Setup - Usuario admin",
      "item": [
        {
          "name": "Cadastrar usuario admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.environment.set('userName', `QA Gabriel ${suffix}`);",
                  "pm.environment.set('userEmail', `qa.gabriel.${suffix}@mail.com`);",
                  "pm.environment.set('userPassword', 'teste123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 - usuario criado', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('retorna mensagem e id do usuario', function () {",
                  "  pm.expect(body.message).to.eql('Cadastro realizado com sucesso');",
                  "  pm.expect(body._id).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.environment.set('userId', body._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"administrador\": \"true\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login usuario admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 - login realizado', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('retorna token bearer', function () {",
                  "  pm.expect(body.message).to.eql('Login realizado com sucesso');",
                  "  pm.expect(body.authorization).to.be.a('string').and.include('Bearer ');",
                  "});",
                  "",
                  "pm.environment.set('token', body.authorization);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
