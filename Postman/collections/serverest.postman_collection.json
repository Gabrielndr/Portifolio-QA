      "item": [
        {
          "name": "Cadastrar produto",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('productName', `Mouse QA ${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 - produto criado', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('retorna mensagem e id do produto', function () {",
                  "  pm.expect(body.message).to.eql('Cadastro realizado com sucesso');",
                  "  pm.expect(body._id).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.environment.set('productId', body._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{productName}}\",\n  \"preco\": 480,\n  \"descricao\": \"Produto criado via Postman/Newman\",\n  \"quantidade\": 120\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Listar produtos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 - lista produtos', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('contrato basico da lista de produtos', function () {",
                  "  pm.expect(body.quantidade).to.be.a('number');",
                  "  pm.expect(body.produtos).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('produto criado aparece na lista', function () {",
                  "  const productId = pm.environment.get('productId');",
                  "  pm.expect(body.produtos.some((product) => product._id === productId)).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
