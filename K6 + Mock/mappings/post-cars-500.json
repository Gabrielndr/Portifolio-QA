{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/cars",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.brand == 'Volkswagen')]"
      },
      {
        "matchesJsonPath": "$[?(@.model == 'up tsi')]"
      },
      {
        "matchesJsonPath": "$[?(@.year == 2020)]"
      }
    ]
  },
  "response": {
    "status": 500,
    "jsonBody": {
      "message": "Internal server error: model 'up tsi' is not allowed."
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
