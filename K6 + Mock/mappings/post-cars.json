{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/cars",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.brand == 'Volkswagen')]"
      },
      {
        "matchesJsonPath": "$[?(@.model == 'fusca')]"
      },
      {
        "matchesJsonPath": "$[?(@.year == 1965)]"
      }
    ]
  },
  "response": {
    "status": 201,
    "jsonBody": {
      "message": "Car successfully registered!",
      "carId": 6
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
